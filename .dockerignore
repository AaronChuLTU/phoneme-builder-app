# Rebuilt inside the image — copying it in would waste the build cache and
# could smuggle a Windows-compiled Prisma engine into a Linux container.
node_modules

# Build output — regenerated by `next build` inside the image.
.next
out

# Local database and its lock file. The container gets its own, created by
# running migrations on startup, so a stale local copy should never ship.
prisma/dev.db
prisma/dev.db-journal

# Secrets and machine-specific paths. Docker Compose supplies DATABASE_URL
# as a container environment variable instead — see docker-compose.yml.
.env
.env.*

# Editor, git and OS noise irrelevant to the running app.
.git
.gitignore
.vscode
.DS_Store

# Documentation and this repo's own zip artefacts.
*.md
!README.md
*.zip

# Nothing here is needed at runtime, and skipping it keeps the image smaller
# and the build context faster to send to the Docker daemon.
