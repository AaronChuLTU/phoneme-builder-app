// Prisma schema for the Phoneme Activity Builder.
//
// Design notes:
//
//  - Phonemes are stored as rows in their own table and linked to words
//    through WordPhoneme, which carries an explicit `position`. They are
//    never stored as a single string. Symbols such as tʃ, dʒ, æɪ and ɐː
//    occupy two character spaces, so splitting a string by character would
//    corrupt them.
//
//  - SQLite has no native enum type, so string fields such as
//    `Activity.type` are validated in application code before any write.
//
//  - binaryTargets lists both the development platform and the Linux
//    platform Docker runs on, so the query engine exists for both.
//
//  - GenerationEvent and PageView (Assessment 3) store the raw events behind
//    the dashboard. Metrics are computed from these rows on request rather
//    than kept as running totals, so a number on the dashboard can always be
//    traced back to the events that produced it.

generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single phoneme symbol from the HCE inventory.
model Phoneme {
  id      Int    @id @default(autoincrement())
  symbol  String @unique
  label   String
  example String

  rowIndex Int
  colIndex Int

  usages WordPhoneme[]

  @@index([rowIndex, colIndex])
}

/// A named collection of words a teacher can build activities from.
model WordList {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  words      Word[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single word. Its phoneme sequence lives in WordPhoneme.
model Word {
  id      Int    @id @default(autoincrement())
  english String

  wordListId Int
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)

  phonemes WordPhoneme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wordListId, english])
}

/// The ordered link between a word and its phonemes.
model WordPhoneme {
  id Int @id @default(autoincrement())

  wordId Int
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  phonemeId Int
  phoneme   Phoneme @relation(fields: [phonemeId], references: [id], onDelete: Restrict)

  position Int

  @@unique([wordId, position])
  @@index([phonemeId])
}

/// A saved activity configuration.
model Activity {
  id   Int    @id @default(autoincrement())
  name String

  /// "WORDLE" or "WORD_SEARCH". Validated in application code.
  type String

  wordListId Int
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)

  showHints Boolean @default(true)

  // Wordle settings
  maxGuesses Int  @default(6)
  /// Restrict a Wordle to words of this many phonemes. Null means any length.
  wordLength Int?

  // Word search settings
  gridSize     Int     @default(10)
  difficulty   String  @default("medium")
  allowAnswers Boolean @default(true)

  generations GenerationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([wordListId])
}

/// One attempt to generate an activity file, successful or not.
///
/// onDelete: SetNull — deleting an activity keeps its generation history.
/// Usage statistics should not silently shrink because a teacher tidied up
/// their activity list; the event still happened.
model GenerationEvent {
  id Int @id @default(autoincrement())

  activityId Int?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  /// Copied at the time of the event, so the type is still known after the
  /// activity itself is deleted. "UNKNOWN" when the request never resolved
  /// to a real activity (e.g. a bad id).
  activityType String

  success      Boolean
  errorMessage String?
  durationMs   Int

  /// True for records created by prisma/simulate.ts. Kept so the dashboard
  /// can state honestly how much of what it shows is real usage.
  simulated Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([success])
  @@index([activityType])
}

/// Time a visitor spent on one page, reported by the PageTimer component.
model PageView {
  id         Int     @id @default(autoincrement())
  path       String
  durationMs Int
  simulated  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
